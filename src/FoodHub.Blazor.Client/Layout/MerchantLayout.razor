@inherits LayoutComponentBase
@inject IJSRuntime JS
@using FoodHub.Blazor.Client.Component
@using FoodHub.Blazor.Client.Pages.MerchantPages.Side

<nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">


    <NavLink class="navbar-brand ps-3" href="/Merchant/Home">FoodHub</NavLink>

    <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0 link-light" @onclick="ToggleSidebarClick" style="color:#fff"><i class="fas fa-bars"></i></button>


    <div class="ms-auto">

        <Navbar />

    </div>

</nav>
<div id="layoutSidenav">

    <div id="layoutSidenav_nav">

        <MerchantNavMenu/>

    </div>

    <div id="layoutSidenav_content">

        <main>

            <div class="container-fluid px-4">
                @Body

            </div>

        </main>

    </div>

</div>

<GlobalToast/>

@code{

    private async Task ToggleSidebarClick()
    {

        await JS.InvokeVoidAsync("toggleSidebar");
    }

}