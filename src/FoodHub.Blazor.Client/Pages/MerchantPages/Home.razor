@page "/Merchant/Home"

@layout FoodHub.Blazor.Client.Layout.MerchantLayout
@attribute [Authorize(Roles = RoleConstants.Roles.MERCHANT)]
@inject MerChantService merChantService
@inject ToastService toastService

@using FoodHub.Blazor.Client.Pages.MerchantPages.Side;
@using FoodHub.Blazor.Client.Layout
@using FoodHub.Blazor.Client.ApiService.Merchant;

<PageTitle>商户首页 - FoodHub</PageTitle>

<div class="container-fluid px-4">

    @* ==============================
       页面标题
       ============================== *@
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

        <div>
            <h1 class="mb-1">商户首页</h1>

            <div class="text-muted">
                欢迎回来，尊敬的商户！
            </div>
        </div>

        <div class="text-muted">
            <i class="fas fa-calendar-alt me-1"></i>
            @DateTime.UtcNow.ToString("yyyy年MM月dd日")
        </div>

    </div>


    @* ==============================
       第一排：核心经营数据
       ============================== *@
    <div class="row">

        @* 今日营业额 *@
        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small mb-1">
                                今日营业额
                            </div>
                            @* 营业额 *@
                            <div class="h3 mb-0">
                                @TodayTurnover
                            </div>
                        </div>

                        <div class="text-success fs-1">
                            <i class="fas fa-yen-sign"></i>
                        </div>

                    </div>

                    @* <div class="mt-3 small text-success">
                        <i class="fas fa-arrow-up"></i>
                        @TurnoverRate
                        <span class="text-muted ms-1">
                            较昨日
                        </span>
                    </div> *@

                </div>

            </div>

        </div>


        @* 今日订单 *@
        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small mb-1">
                                今日订单
                            </div>

                            <div class="h3 mb-0">
                                @TodayOrders
                            </div>
                        </div>

                        <div class="text-primary fs-1">
                            <i class="fas fa-shopping-cart"></i>
                        </div>

                    </div>

                    @* <div class="mt-3 small text-success">
                        <i class="fas fa-arrow-up"></i>
                            @OrdersRate
                        <span class="text-muted ms-1">
                            较昨日
                        </span>
                    </div> *@

                </div>

            </div>

        </div>


        @* 待处理订单 *@
        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small mb-1">
                                待处理订单
                            </div>

                            <div class="h3 mb-0">
                                @PendingOrders
                            </div>
                        </div>

                        <div class="text-warning fs-1">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-warning">
                        <i class="fas fa-clock"></i>
                        等待处理
                    </div>

                </div>

            </div>

        </div>


        @* 菜品数量 *@
        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small mb-1">
                                菜品数量
                            </div>

                            <div class="h3 mb-0">
                                @DishesCount
                            </div>
                        </div>

                        <div class="text-info fs-1">
                            <i class="fas fa-utensils"></i>
                        </div>

                    </div>

                    <div class="mt-3 small text-muted">
                        @OnsaleCount 个在售
                    </div>

                </div>

            </div>

        </div>

    </div>


    @* ==============================
       第二排：营业趋势 + 待处理事项
       ============================== *@
    <div class="row">


        @* 营业趋势 *@
        <div class="col-xl-8 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h6 class="m-0 fw-bold">
                            营业趋势
                        </h6>

                        <div class="btn-group btn-group-sm">

                            <button class="btn btn-outline-secondary">
                                今日
                            </button>

                            <button class="btn btn-outline-secondary">
                                本周
                            </button>

                            <button class="btn btn-outline-secondary">
                                本月
                            </button>

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    <div class="text-muted small mb-3">
                        今日营业额
                    </div>


                    @* 简单的 SVG 趋势图 *@
                    <div style="height: 280px;">

                        <svg width="100%"
                             height="100%"
                             viewBox="0 0 800 280"
                             preserveAspectRatio="none">

                            @* 横向辅助线 *@

                            <line x1="0" y1="40"
                                  x2="800" y2="40"
                                  stroke="#e9ecef" />

                            <line x1="0" y1="100"
                                  x2="800" y2="100"
                                  stroke="#e9ecef" />

                            <line x1="0" y1="160"
                                  x2="800" y2="160"
                                  stroke="#e9ecef" />

                            <line x1="0" y1="220"
                                  x2="800" y2="220"
                                  stroke="#e9ecef" />


                            @* 营业额曲线 *@

                            <polyline fill="none"
                                      stroke="#0d6efd"
                                      stroke-width="4"
                                      points="
                                0,210
                                80,190
                                160,200
                                240,150
                                320,170
                                400,120
                                480,140
                                560,90
                                640,110
                                720,70
                                800,50" />


                            @* 数据点 *@

                            <circle cx="0" cy="210" r="5" fill="#0d6efd" />
                            <circle cx="80" cy="190" r="5" fill="#0d6efd" />
                            <circle cx="160" cy="200" r="5" fill="#0d6efd" />
                            <circle cx="240" cy="150" r="5" fill="#0d6efd" />
                            <circle cx="320" cy="170" r="5" fill="#0d6efd" />
                            <circle cx="400" cy="120" r="5" fill="#0d6efd" />
                            <circle cx="480" cy="140" r="5" fill="#0d6efd" />
                            <circle cx="560" cy="90" r="5" fill="#0d6efd" />
                            <circle cx="640" cy="110" r="5" fill="#0d6efd" />
                            <circle cx="720" cy="70" r="5" fill="#0d6efd" />
                            <circle cx="800" cy="50" r="5" fill="#0d6efd" />

                        </svg>

                    </div>


                    <div class="d-flex justify-content-between text-muted small mt-2">

                        <span>08:00</span>
                        <span>10:00</span>
                        <span>12:00</span>
                        <span>14:00</span>
                        <span>16:00</span>
                        <span>18:00</span>
                        <span>20:00</span>
                        <span>22:00</span>

                    </div>

                </div>

            </div>

        </div>


        @* 待处理事项 *@
        <div class="col-xl-4 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h6 class="m-0 fw-bold">
                        需要处理
                    </h6>

                </div>


                <div class="card-body">


                    @* 待处理订单 *@
                    <div class="d-flex align-items-center mb-4">

                        <div class="me-3 text-warning fs-3">
                            <i class="fas fa-shopping-cart"></i>
                        </div>

                        <div class="flex-grow-1">

                            <div class="fw-bold">
                                @PendingOrders 个订单等待处理
                            </div>

                            <div class="small text-muted">
                                请及时处理新订单
                            </div>

                        </div>

                        @* <a href="/Orders"
                           class="btn btn-sm btn-outline-primary">
                            查看
                        </a> *@

                    </div>


                    @* 菜品库存 *@
                    @* <div class="d-flex align-items-center mb-4">

                        <div class="me-3 text-danger fs-3">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>

                        <div class="flex-grow-1">

                            <div class="fw-bold">
                                3 个菜品库存不足
                            </div>

                            <div class="small text-muted">
                                建议及时补充库存
                            </div>

                        </div>

                        <a href="/FoodManagement"
                           class="btn btn-sm btn-outline-primary">
                            查看
                        </a>

                    </div> *@


                    @* 下架菜品 *@
                    <div class="d-flex align-items-center">

                        <div class="me-3 text-secondary fs-3">
                            <i class="fas fa-ban"></i>
                        </div>

                        <div class="flex-grow-1">

                            <div class="fw-bold">
                                @DiscontinuedDishesCount 个菜品已下架
                            </div>

                            <div class="small text-muted">
                                检查是否需要重新上架
                            </div>

                        </div>

                        @* <a href="/FoodManagement"
                           class="btn btn-sm btn-outline-primary">
                            查看
                        </a> *@

                    </div>

                </div>

            </div>

        </div>

    </div>


    @* ==============================
       第三排：最近订单 + 热销菜品
       ============================== *@
    <div class="row">


        @* 最近订单 *@
        <div class="col-xl-8 mb-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h6 class="m-0 fw-bold">
                            今日最近订单
                        </h6>

                        <a href="/Merchant/OrderManagement"
                           class="small text-decoration-none">
                            查看全部 →
                        </a>

                    </div>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>订单编号</th>

                                    <th>下单时间</th>

                                    <th>金额</th>

                                    <th>状态</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var order in Orders)
                                {
                                    <tr>
                                        @* 编号 *@
                                        <td>
                                            @order.OrderNumber
                                        </td>
                                        @* 下单时间 *@
                                        <td>
                                            @order.OrderDate.ToString("yyyy年MM月dd日mm分")
                                        </td>
                                        @* 订单金额 *@
                                        <td>
                                            @order.TotalPrice
                                        </td>
                                        @* 状态 *@
                                        <td>
                                            @order.Status.GetDisplayName()
                                        </td>
                                    </tr>
                                  
                                }

                                @* <tr>

                                    <td>
                                        #20260824001
                                    </td>

                                    <td>
                                        10:32
                                    </td>

                                    <td>
                                        ¥38.00
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            待处理
                                        </span>
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        #20260824002
                                    </td>

                                    <td>
                                        10:28
                                    </td>

                                    <td>
                                        ¥56.00
                                    </td>

                                    <td>
                                        <span class="badge bg-info">
                                            配送中
                                        </span>
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        #20260824003
                                    </td>

                                    <td>
                                        10:15
                                    </td>

                                    <td>
                                        ¥28.00
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            已完成
                                        </span>
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        #20260824004
                                    </td>

                                    <td>
                                        09:57
                                    </td>

                                    <td>
                                        ¥72.00
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            已完成
                                        </span>
                                    </td>

                                </tr> *@

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        @* 热销菜品 *@
        <div class="col-xl-4 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h6 class="m-0 fw-bold">
                            热销菜品
                        </h6>

                        <a href="/Merchant/FoodManagement"
                           class="small text-decoration-none">
                            管理菜品 →
                        </a>

                    </div>

                </div>


                <div class="card-body">

                  @foreach(var (hotSaleDish,index) in HotSaleDishes.Select((item,i) => (item,i))){

                      if (index == 0) { 
                        <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="d-flex align-items-center">

                            <div class="me-3 text-warning fs-4">
                                <i class="fas fa-medal"></i>
                            </div>

                            <div>

                                <div class="fw-bold">
                                    @hotSaleDish.ProductName
                                </div>

                                <div class="small text-muted">
                                    售出 @hotSaleDish.TotalCount 份
                                </div>

                            </div>

                        </div>

                        <strong>
                            ¥@hotSaleDish.TotalSaleAmount.ToString("N0")
                        </strong>

                    </div>
                
                    }
                   else{
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="d-flex align-items-center">

                            <div class="me-3 text-secondary fs-4">
                                <i class="fas fa-medal"></i>
                            </div>

                            <div>

                                <div class="fw-bold">
                                    @hotSaleDish.ProductName
                                </div>

                                <div class="small text-muted">
                                    售出 @hotSaleDish.TotalCount 份
                                </div>

                            </div>

                        </div>

                        <strong>
                            ¥@hotSaleDish.TotalSaleAmount.ToString("N0")
                        </strong>

                    </div>
                    }
                   }

                    @* <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            <div class="me-3 text-muted fs-4">
                                <i class="fas fa-medal"></i>
                            </div>

                            <div>

                                <div class="fw-bold">
                                    可乐
                                </div>

                                <div class="small text-muted">
                                    售出 65 份
                                </div>

                            </div>

                        </div>

                        <strong>
                            ¥455
                        </strong>

                    </div> *@

                </div>

            </div>

        </div>

    </div>

</div>



    @code {

    //营业额
    private decimal TodayTurnover { get; set; }

    //今日订单(只显示前4个)
    private int TodayOrders { get; set; } 

    //营业额比率
    private decimal TurnoverRate { get; set; }

    //订单比率
    private decimal OrdersRate { get; set; }

    //菜品数量
    private int DishesCount { get; set; }

    //在售菜品数量
    private int OnsaleCount { get; set; }

    //等待处理订单
    private int PendingOrders { get; set; }

    //已经下架菜品数量
    private int DiscontinuedDishesCount { get; set; }

    //今日最近订单
    private List<OrderDto> Orders = new();

    //热销菜品
    private List<HotSaleDto> HotSaleDishes = new();

    private DashBoardDto dashBoard = new();

    private async Task DefaultRefreshInfoAsync()
    {
        try
        {
            var result = await merChantService.GetDashBoardAsync();

            if (!result.IsSuccess)
            {
                return;
            }
            else
            {
                if (result.Data != null)
                {
                    dashBoard = result.Data;

                    TodayTurnover = dashBoard.TodayTurnover;

                    TodayOrders = dashBoard.TodayOrders;

                    DishesCount = dashBoard.DishesCount;

                    PendingOrders = dashBoard.PendingOrders;

                    OnsaleCount = dashBoard.OnSaleDishesCount;

                    DiscontinuedDishesCount = DishesCount - OnsaleCount;

                    Orders = dashBoard.Orders;

                    HotSaleDishes = dashBoard.HotSaleDishes;
                }

            }

        }
        catch (Exception)
        {



        }


    }




    protected override async Task OnInitializedAsync()
    {
        await DefaultRefreshInfoAsync();
    }

   
}
