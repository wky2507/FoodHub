@page "/Merchant/FoodManagement/EditDishes/{Id:int}"
@attribute [Authorize(Roles = RoleConstants.Roles.MERCHANT)]

@using System.Net.Http
@using static System.Net.WebRequestMethods

@inject NavigationManager Navigation
@inject ToastService toastService
@inject HttpService httpService
@inject MerChantService merChantService
@inject IImageTools ImageTools 
<PageTitle>编辑菜品 - FoodHub</PageTitle>

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

        <div>

            <h1 class="mb-1">
                编辑菜品
            </h1>

            <div class="text-muted">
                修改菜品信息
            </div>

        </div>


        <button class="btn btn-outline-secondary"
                @onclick="GoBack">

            <i class="fas fa-arrow-left me-1"></i>

            返回菜品管理

        </button>

    </div>


    @if (IsLoading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"></div>

            <div class="mt-3 text-muted">
                正在加载菜品信息...
            </div>

        </div>
    }
    else
    {
        <EditForm Model="@InputModel"
                  OnValidSubmit="HandleSubmit">

            <DataAnnotationsValidator />

            <ValidationSummary />


            <div class="row">


                <div class="col-lg-8">


                    @* ======================
                       基本信息
                       ====================== *@
                    <div class="card border-0 shadow-sm mb-4">

                        <div class="card-header bg-white py-3">

                            <h5 class="mb-0">

                                <i class="fas fa-info-circle text-primary me-2"></i>

                                基本信息

                            </h5>

                        </div>


                        <div class="card-body">

                            <div class="row">


                                <div class="col-md-6 mb-3">

                                    <label class="form-label">

                                        菜品名称

                                        <span class="text-danger">*</span>

                                    </label>

                                    <InputText class="form-control"
                                               placeholder="请输入菜品名称"
                                               @bind-Value="InputModel.Name" />

                                    <ValidationMessage For="@(() => InputModel.Name)" />

                                </div>


                                <div class="col-md-6 mb-3">

                                    <label class="form-label">

                                        菜品分类

                                    </label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="InputModel.SelectCategory"
                                                 @bind-Value:after="OnChangeSelect">
                                        @foreach (KindofFood category in Enum.GetValues<KindofFood>())
                                        {
                                            if (category == KindofFood.None)
                                            {

                                                <option value="">

                                                  -- 全部分类 --  

                                                </option>
                                            }
                                            else
                                            {

                                                <option value="@category">

                                                    @category.GetDisplayName()

                                                </option>
                                            }
                                        }

                                    </InputSelect>
                                    <ValidationMessage For="()=> InputModel.SelectCategory"/>
                                </div>


                                <div class="col-md-6 mb-3">

                                    <label class="form-label">

                                        菜品价格

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            ¥
                                        </span>

                                        <InputNumber class="form-control"
                                                      placeholder="请输入价格"
                                                     @bind-Value="InputModel.Price" />
                                        <ValidationMessage For="()=>InputModel.Price"/>
                                    </div>

                                </div>


                            </div>

                        </div>

                    </div>


                    @* ======================
                       菜品图片
                       ====================== *@

                    @* ============================
                   菜品图片
                   ============================ *@
                    <div class="card border-0 shadow-sm mb-4">

                        <div class="card-header bg-white py-3">

                            <h5 class="mb-0">

                                <i class="fas fa-image text-primary me-2"></i>

                                菜品图片(可选)

                            </h5>

                        </div>


                        <div class="card-body">


                            <div class="mb-3">

                                <label class="form-label">

                                    上传菜品图片

                                    <span class="text-danger">*</span>

                                </label>

                                <div class="text-muted small mb-3">

                                    支持 JPG、PNG、JPEG 格式

                                </div>


                                <InputFile id="imageInput" OnChange="HandleFileSelected"
                                           accept=".jpg,.png,.jpeg"
                                           class="form-control d-none" />
                                <br />
                                <label for="imageInput" class="btn btn-primary">请选择图片</label>
                                
                                @if (!string.IsNullOrEmpty(InputModel.PictureUri)) { 

                                    <span>@Path.GetFileName(DownloadPath)</span>
                                
                                }
                                <!-- 等待上传 -->
                                @if (isUploadingImage)
                                {
                                    <div class="mt-2 text-primary small">
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        图片上传中,请稍候...
                                    </div>

                                }
                            </div>


                            @* 图片预览 *@
                            @if (!string.IsNullOrEmpty(InputModel.PictureUri))
                            {

                                <div class="border rounded p-3">

                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        @* <img src="@DownloadPath"
                                             class="img-thumbnail me-3"
                                             style="width:200px;height:150px;object-fit:cover;"
                                             alt="菜品图片预览" /> *@
                                        <ImageDownload Src="@InputModel.PictureUri" Alt="菜品图片预览" Class="img-thumbnail me-3" Style="width:200px;height:150px;object-fit:cover;" GetImageBytesAsync="imageTools.GetDishesImageAsync"/>
                                         @if(isSuccessUploadDishesImage){

                                            <span class="text-success small d-block mt-1">✓ 图片已成功上传</span>
                                         
                                         }

                                        <div>

                                            <div class="fw-bold mb-2">

                                                图片预览

                                            </div>


                                          @*   <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="RemoveImage_OnClick">

                                                <i class="fas fa-trash me-1"></i>

                                                删除图片

                                            </button> *@

                                        </div>

                                    </div>

                                </div>

                            }

                        </div>

                    </div>


                    @* ======================
                       销售状态
                       ====================== *@
                    <div class="card border-0 shadow-sm mb-4">

                        <div class="card-header bg-white py-3">

                            <h5 class="mb-0">

                                <i class="fas fa-store text-primary me-2"></i>

                                销售信息

                            </h5>

                        </div>


                        <div class="card-body">

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       @bind="InputModel.IsOnsale"/>

                                <label class="form-check-label">

                                    @if (InputModel.IsOnsale)
                                    {
                                        <span class="text-success">
                                            当前在售
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            当前已下架
                                        </span>
                                    }

                                </label>

                            </div>

                        </div>

                    </div>


                    @* ======================
                       保存
                       ====================== *@
                    <div class="card border-0 shadow-sm mb-5">

                        <div class="card-body">

                            <div class="d-flex justify-content-end">

                                <button type="button"
                                        class="btn btn-outline-secondary me-2"
                                        @onclick="GoBack">

                                    取消

                                </button>


                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="fas fa-save me-1"></i>

                                    保存修改

                                </button>

                            </div>

                        </div>

                    </div>


                </div>


                @* 右侧提示 *@
                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm">

                        <div class="card-header bg-white py-3">

                            <h6 class="mb-0">
                                编辑提示
                            </h6>

                        </div>


                        <div class="card-body">

                            <ul class="small text-muted ps-3">

                                <li class="mb-2">
                                    修改后请点击保存修改
                                </li>

                                <li class="mb-2">
                                    不上传新图片将保留旧图片
                                </li>

                                <li>
                                    修改价格后将立即影响销售价格
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

        </EditForm>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    private IImageTools imageTools { get; set; } = default!;

    private bool IsLoading = true;

    private string? DownloadPath;

    private ProductDto InputModel = new();

    [Inject]
    private IOptions<BaseUrlConfiguration> options { get; set; } = default!;

    [Inject]
    private PathTools pathTools { get; set; } = default!;

    private bool isUploadingImage { get; set; } = false;

    private bool isSuccessUploadDishesImage { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDish();
    }


    private async Task LoadDish()
    {
        IsLoading = true;

        try
        {
            var request = new GetDishRequest(Id);

            var response = await merChantService.GetProductDtoAsync(request);

            if (!response.IsSuccess)
            {

                toastService.ShowError("加载失败,请刷新重试");

            }
            else
            {

                if (response.Data != null) {

                    InputModel = response.Data;

                    DownloadPath = pathTools.DishesImageDownloadCombine(InputModel.PictureUri);

                }

            }


        }
        finally
        {
            IsLoading = false;
        }
    }

    //上传图片
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {

        try
        {
            isUploadingImage = true;

            var result = await ImageTools.UploadDishesImage(e);

            if (result.IsSuccess && result.Data!= null && !string.IsNullOrWhiteSpace(result.Data.Url))
            {
                InputModel.PictureUri = result.Data.Url;

                DownloadPath = pathTools.DishesImageDownloadCombine(InputModel.PictureUri);

                isSuccessUploadDishesImage = true;
            }
            else
            {

                toastService.ShowError("上传照片失败");

            }
        }
        catch (Exception)
        {

        }
        finally
        {
            isUploadingImage = false;
        }

    }

    //保存
    private async Task HandleSubmit()
    {
        var response = await merChantService.UpdateDishesAsync(InputModel);

        if (!response.IsSuccess)
        {
            toastService.ShowError($"保存失败,{response.Message}");
            return;
        }
        else
        {

            toastService.ShowSuccess($"保存成功");
        }

        Navigation.NavigateTo(
            "/Merchant/FoodManagement");
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/Merchant/FoodManagement");
    }

    private void OnChangeSelect()
    {
        if (!InputModel.SelectCategory.HasValue)
        {
            return;

        }
        else
        {
            InputModel.CategoryName = (int)InputModel.SelectCategory;
        }

    }

    private async Task RemoveImage_OnClick()
    {
        try
        {

            await ImageTools.DeleteImage(InputModel);

        }
        catch (Exception)
        {


        }
        finally
        {
            
        }
    }

    
}

