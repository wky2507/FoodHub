{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {

        //"Microsoft.EntityFrameworkCore": "Information",

        //"Microsoft.AspNetCore.DataProtection": "Warning",

        //"Microsoft.AspNetCore": "Information",

        //"Microsoft.Extension.Http": "Information",

        //"Microsoft.Extensions": "Warning",

        "PublicApi": "Information",

        "Application": "Information"

        //"Infrastructure": "Information",

        //"Domain": "Information"
      }

    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/log-{Date}.txt" }
      }
    ]
  },


  "ConnectionStrings": {
    //"CatalogConnection": "Server=DESKTOP-E8GIDJH;Database=FoodHubDb;User Id=sa;Password=123456;TrustServerCertificate=True",
    "CatalogConnection": "Server=sqlserver,1433;Database=FoodHubDb;User Id=sa;Password=FoodHub_12345678!;TrustServerCertificate=True"

  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "SecretKey": "SecretKeyOfDoomThatMustBeAMinimumNumberOfBytes",
    "Issuer": "FoodHub.PublicApi",
    "Audience": "FoodHub.Blazor.Client",
    "ExpireMinute": 20,
    "ExpireDay": 7
  },


  "AllowedHosts": "*",

  "FileStorage": {
    "LicenseUploadPath": "/app/wwwroot/uploads/licenses",
    "DishesUploadPath": "/app/wwwroot/uploads/dishes"
  }
}
